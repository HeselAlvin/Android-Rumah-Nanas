<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="24dp"
    android:gravity="center">

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Verifikasi OTP"
        android:textSize="24sp"
        android:textStyle="bold"
        android:textAlignment="center"
        android:layout_marginBottom="8dp"/>

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Masukkan 6 digit kode yang kami kirimkan ke email Anda."
        android:textAlignment="center"
        android:layout_marginBottom="24dp"/>

    <EditText
        android:id="@+id/etOtpCode"
        android:layout_width="match_parent"
        android:layout_height="50dp"
        android:background="@android:drawable/editbox_background"
        android:hint="Kode OTP"
        android:inputType="number"
        android:maxLength="6"
        android:textAlignment="center"
        android:textSize="12sp"
        android:layout_marginBottom="24dp"/>

    <Button
        android:id="@+id/btnVerify"
        android:backgroundTint="@color/Yellow_pineapple"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Verifikasi Sekarang" />

</LinearLayout>