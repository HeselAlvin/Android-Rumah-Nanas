<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FFFFFF">

    <LinearLayout
        android:id="@+id/toolbarAddress"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingHorizontal="16dp">

        <ImageView
            android:id="@+id/btnBackAddress"
            android:layout_width="28dp"
            android:layout_height="28dp"
            android:src="@drawable/ic_left"
            app:tint="@color/Yellow_pineapple" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="16dp"
            android:text="Alamat Baru"
            android:textSize="18sp"
            android:textColor="#111111"
            android:textStyle="bold"/>
    </LinearLayout>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_below="@id/toolbarAddress"
        android:layout_above="@id/btnSaveAddressLayout">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingHorizontal="16dp"
            android:paddingTop="8dp">

            <EditText
                android:id="@+id/etLabel"
                android:layout_width="match_parent"
                android:layout_height="50dp"
                android:background="@null"
                android:hint="Label Alamat (Contoh: Rumah, Kantor)"
                android:textColorHint="#AAAAAA"
                android:textColor="#333333"
                android:textSize="14sp" />
            <View android:layout_width="match_parent" android:layout_height="1dp" android:background="#EEEEEE" android:layout_marginBottom="8dp"/>

            <EditText
                android:id="@+id/etReceiverName"
                android:layout_width="match_parent"
                android:layout_height="50dp"
                android:background="@null"
                android:hint="Nama Lengkap"
                android:inputType="textPersonName"
                android:textColorHint="#AAAAAA"
                android:textColor="#333333"
                android:textSize="14sp" />
            <View android:layout_width="match_parent" android:layout_height="1dp" android:background="#EEEEEE" android:layout_marginBottom="8dp"/>

            <EditText
                android:id="@+id/etPhoneNumber"
                android:layout_width="match_parent"
                android:layout_height="50dp"
                android:background="@null"
                android:hint="Nomor Telepon"
                android:inputType="phone"
                android:textColorHint="#AAAAAA"
                android:textColor="#333333"
                android:textSize="14sp" />
            <View android:layout_width="match_parent" android:layout_height="1dp" android:background="#EEEEEE" android:layout_marginBottom="8dp"/>

            <EditText
                android:id="@+id/etCompleteAddress"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:minHeight="50dp"
                android:background="@null"
                android:hint="Nama Jalan, Gedung, No. Rumah, Kota"
                android:inputType="textMultiLine"
                android:gravity="top|start"
                android:paddingTop="12dp"
                android:textColorHint="#AAAAAA"
                android:textColor="#333333"
                android:textSize="14sp" />
            <View android:layout_width="match_parent" android:layout_height="1dp" android:background="#EEEEEE" android:layout_marginBottom="8dp"/>

        </LinearLayout>
    </ScrollView>

    <LinearLayout
        android:id="@+id/btnSaveAddressLayout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_alignParentBottom="true"
        android:background="#FFFFFF"
        android:paddingHorizontal="16dp"
        android:paddingVertical="16dp">

        <androidx.cardview.widget.CardView
            android:id="@+id/btnSaveAddress"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            app:cardBackgroundColor="#F5D053"
            app:cardCornerRadius="24dp"
            app:cardElevation="0dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:gravity="center"
                android:text="Simpan Alamat"
                android:textColor="#111111"
                android:textSize="16sp"
                android:textStyle="bold" />
        </androidx.cardview.widget.CardView>
    </LinearLayout>

</RelativeLayout>